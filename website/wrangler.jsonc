{
  // Nira's site, as a Workers static-assets deployment.
  //
  // Not Pages: both have the same 25 MiB per-file ceiling, but Workers keeps
  // its configuration in the repository, so what is deployed is reviewable in
  // a diff rather than set in a dashboard.
  //
  // Deploy:  npx wrangler deploy --config website/wrangler.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nira-site",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./public",
    // The site is one document. A bad path should 404 rather than quietly
    // return the homepage with a 200 — which would also break the page's
    // HEAD probe for whether a download exists.
    "not_found_handling": "404-page",
    "run_worker_first": false
  },

  "observability": { "enabled": true },

  // The apk is NOT in ./public for this deployment: at 42 MiB it exceeds the
  // 25 MiB per-file limit that applies to both Pages and Workers assets.
  // It is served from R2, which has no egress fee and no practical size
  // limit, via DOWNLOADS_BASE below.
  "vars": {
    "DOWNLOADS_BASE": "https://dl.kovasis.com"
  }
}
